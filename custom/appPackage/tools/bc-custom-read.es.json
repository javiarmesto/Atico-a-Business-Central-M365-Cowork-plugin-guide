{
  "tools": [
    {
      "name": "get-customers",
      "description": "Obtiene lista de clientes de Business Central",
      "inputSchema": {
        "type": "object",
        "properties": {
          "top": {
            "type": "number",
            "description": "Máximo de clientes (default 200)"
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "get-customer",
      "description": "Obtiene detalle de un cliente por su número",
      "inputSchema": {
        "type": "object",
        "properties": {
          "customer_no": {
            "type": "string",
            "description": "Número del cliente (ej: '10000')"
          }
        },
        "required": [
          "customer_no"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    }
  ]
}
