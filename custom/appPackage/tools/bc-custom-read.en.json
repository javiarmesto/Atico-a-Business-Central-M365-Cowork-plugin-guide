{
  "tools": [
    {
      "name": "get-customers",
      "description": "Lists customers from your Business Central MCP server.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "top": {
            "type": "number",
            "description": "Maximum number of customers (server default: 200)."
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "get-customer",
      "description": "Gets a customer by number from your Business Central MCP server.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "customer_no": {
            "type": "string",
            "description": "Customer number, for example 10000."
          }
        },
        "required": [
          "customer_no"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    }
  ]
}
